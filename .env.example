# Farm-Aid Backend Environment Configuration
# Copy to .env and adjust values. Never commit the real .env.

# ==========================================
# Node Environment
# ==========================================
NODE_ENV=development

# ==========================================
# Server Configuration
# ==========================================
PORT=5000
FRONTEND_URL=http://localhost:5173

# ==========================================
# PostgreSQL Configuration
# ==========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=farmaid
DB_USER=postgres
DB_PASSWORD=postgres

# Alternative: full connection string (takes precedence over DB_* above)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/farmaid

# ==========================================
# JWT Configuration
# ==========================================
JWT_SECRET=change-me-in-production-farm-aid-2026
JWT_REFRESH_SECRET=change-me-refresh-farm-aid-2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# CouchDB Configuration (sync endpoint for PouchDB)
# ==========================================
COUCHDB_URL=http://couchdb:5984
COUCHDB_PORT=5984
COUCHDB_DB=farmaid_sync
COUCHDB_USER=admin
COUCHDB_PASSWORD=password123

# ==========================================
# Redis Configuration
# ==========================================
REDIS_URL=redis://redis:6379

# ==========================================
# Security
# ==========================================
BCRYPT_SALT_ROUNDS=12

# ==========================================
# Upload Configuration
# ==========================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ==========================================
# Africa's Talking SMS (sandbox credentials)
# ==========================================
AT_USERNAME=sandbox
AT_API_KEY=atsandbox_xxx
AT_FROM=FarmAid

# ==========================================
# Email Configuration (optional)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@farmaid.com

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=info

# ==========================================
# Feature Flags
# ==========================================
ENABLE_CLOUD_AI=false
ENABLE_SMS=false