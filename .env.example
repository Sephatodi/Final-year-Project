# Root (frontend/build) environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# API
API_URL=http://localhost:5000
API_VERSION=v1
LOG_LEVEL=info

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Database (PostgreSQL / Neon)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=far_aid
DB_USER=postgres
DB_PASSWORD=change-me
# Or use a full connection string (takes precedence):
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# CouchDB (optional, for sync)
COUCHDB_URL=http://localhost:5984
COUCHDB_DB=far_aid
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me

# Email (optional, SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Backend-only (also read from Backend/.env)
PORT=5000
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads