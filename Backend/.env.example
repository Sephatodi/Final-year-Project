# Backend environment (copy to Backend/.env)
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (Neon or local). DATABASE_URL takes precedence over DB_* below.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=far_aid
DB_USER=postgres
DB_PASSWORD=change-me

# CouchDB (optional, for sync)
COUCHDB_URL=http://localhost:5984
COUCHDB_DB=far_aid
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production

# Uploads
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI (optional — falls back to rule-based if TensorFlow unavailable)
AI_MODEL_PATH=